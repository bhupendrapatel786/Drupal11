# Ignore directories generated by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/libraries/
/web/.*
backups

# Ignore sensitive information
web/sites/*/settings.local.php
web/sites/*/local.settings.php
web/sites/**/local.services.yml
web/sites/**/redis.services.yml
web/sites/default/settings/local.settings.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# DrupalVM
config/local.config.yml

# Node
node_modules/

# Add SSO certs
config/sso/cert/*

# Private files
/private/
/files-private

# Ignore failed patching of the .htaccess file
/docroot/.htaccess.rej

# Release hash
/release.txt

# Mac files.
.DS_Store

# Database backup files.
*.sql


# PhpStrom
.idea

# Local documentation directory.
/local/
/.editorconfig
/.gitattributes
databases
db_backups
backups
.ddev/
recipes/
